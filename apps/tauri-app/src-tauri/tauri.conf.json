{
	"productName": "Kilo Code",
	"version": "1.0.0",
	"identifier": "com.kilocode.tauri",
	"build": {
		"beforeDevCommand": "cd ../../webview-ui && pnpm dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "cd ../.. && pnpm --filter @kilocode/tauri-app build:frontend",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		},
		"macOS": {
			"frameworks": [],
			"minimumSystemVersion": "10.13",
			"exceptionDomain": "",
			"signingIdentity": null,
			"entitlements": null
		},
		"linux": {
			"deb": {
				"depends": []
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "Kilo Code",
				"width": 1200,
				"height": 800,
				"resizable": true,
				"fullscreen": false,
				"decorations": true
			}
		],
		"security": {
			"csp": null
		}
	}
}
