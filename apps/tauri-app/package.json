{
	"name": "@kilocode/tauri-app",
	"version": "1.0.0",
	"description": "Tauri wrapper for Kilo Code webview-ui",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"build": "npm run build:frontend && tauri build",
