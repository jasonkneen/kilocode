		"tauri": "tauri",
		"clean": "rimraf dist build src-tauri/target"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.1.0",
		"rimraf": "^6.0.1"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.1.1",
		"@tauri-apps/plugin-shell": "^2.0.2"
	}
}
